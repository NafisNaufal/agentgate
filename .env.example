# Required Postgres audit store (PRD F14). AgentGate refuses to run without it.
AGENTGATE_AUDIT_DSN=postgresql://agentgate:agentgate@localhost:5432/agentgate

# Required full-LLM detector runtime
OLLAMA_HOST=http://localhost:11434
AGENTGATE_LLM_DETECTOR_MODEL=qwen2.5:7b
AGENTGATE_LLM_DETECTOR_TIMEOUT=30

# Gmail (Sprint 1 connector baseline). Calendar and Telegram are post-Sprint-1B.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify
GOOGLE_TOKEN_FILE=token.json
# Pin the loopback callback port on a headless host so it can be SSH-forwarded.
GOOGLE_OAUTH_PORT=8765

# Chat REPL planner (agentgate chat). "ollama" runs locally (default, no key needed);
# openrouter/openai/gemini/anthropic need AGENTGATE_LLM_API_KEY.
AGENTGATE_LLM_PROVIDER=ollama
AGENTGATE_LLM_MODEL=
AGENTGATE_LLM_API_KEY=

# GitHub
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Filesystem
AGENTGATE_SANDBOX_ROOT=./sandbox
AGENTGATE_FILE_MAX_BYTES=1048576

# Playwright
AGENTGATE_BROWSER_HEADLESS=true
AGENTGATE_BROWSER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AGENTGATE_SCREENSHOT_DIR=./artifacts/screenshots
